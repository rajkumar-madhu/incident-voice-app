# Finspot Voice Agent Integration

# Webhook receiver port
PORT=3100

# Secret to verify incoming webhooks (must match agent's webhook_secret)
WEBHOOK_SECRET=your-webhook-secret-here

# Voice Agent API (for setup script and REST calls)
VOICE_API_URL=https://voice.api.santhira.com
VOICE_WS_URL=https://voice.santhira.com

# Auth credentials (use ONE of these)
# Option A: JWT token (get from POST /auth/login)
JWT_TOKEN=

# Option B: API key (get from POST /api-keys)
API_KEY=
TENANT_ID=

# Agent config
AGENT_NAME=finspot-itsm-agent
AGENT_LANGUAGE=en

# Finspot app URL (for CORS and redirects)
FINSPOT_APP_URL=https://fs-le-dev-inc.finspot.in
